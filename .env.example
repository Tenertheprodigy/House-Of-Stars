# Public browser-safe values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values (never prefix these with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
# At least 32 random characters; signs the HTTP-only application session cookie.
APP_SESSION_SECRET=
# Separate secret for the private admin application; at least 32 characters.
ADMIN_SESSION_SECRET=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
QUICK_SELL_MAX_USD=10
QUICK_SELL_COOLDOWN_DAYS=30
QUICK_SELL_QUOTE_TTL_SECONDS=60
QUICK_SELL_USD_PER_STAR=0.001455
APPLE_GOOGLE_SETTLEMENT_DAYS=21
GIFT_SETTLEMENT_DAYS=7
# Optional user-facing estimate for ordinary processing orders.
ESTIMATED_PROCESSING_DAYS=
# Keep this network name identical to the signer worker configuration.
PAYOUT_ASSETS_JSON=
MINIAPP_URL=http://localhost:3000
BOT_PORT=3002
# Public bot API base used by the Mini App to call invoice creation.
NEXT_PUBLIC_BOT_API_URL=http://localhost:3002
